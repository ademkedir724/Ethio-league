generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  LEAGUE_ADMIN
  CLUB_ADMIN
  REFEREE
  PLAYER
  COACH
  FAN
}

enum OrgStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ClubStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  POSTPONED
  CANCELLED
}

enum EventType {
  GOAL
  ASSIST
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
  PENALTY
  OWN_GOAL
}

enum PlayerPosition {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum SeasonStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

// ─── Models ─────────────────────────────────────────────────

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  passwordHash   String
  name           String
  role           Role      @default(FAN)
  avatarUrl      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  organization   Organization? @relation("OrgOwner")
  managedLeagues League[]      @relation("LeagueAdmin")
  player         Player?
  coach          Coach?
  referee        Referee?
  notifications  Notification[]

  @@map("users")
}

model Organization {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  logoUrl     String?
  status      OrgStatus @default(PENDING)
  ownerId     Int       @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  owner   User     @relation("OrgOwner", fields: [ownerId], references: [id])
  leagues League[]

  @@map("organizations")
}

model League {
  id             Int      @id @default(autoincrement())
  name           String
  description    String?
  logoUrl        String?
  organizationId Int
  adminId        Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  admin        User?        @relation("LeagueAdmin", fields: [adminId], references: [id])
  seasons      Season[]
  clubs        Club[]
  rules        LeagueRule[]
  referees     RefereeLeague[]

  @@map("leagues")
}

model LeagueRule {
  id       Int    @id @default(autoincrement())
  leagueId Int
  title    String
  body     String

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@map("league_rules")
}

model Season {
  id        Int          @id @default(autoincrement())
  name      String
  leagueId  Int
  status    SeasonStatus @default(UPCOMING)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  league    League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  matches   Match[]
  standings Standing[]

  @@map("seasons")
}

model Club {
  id        Int        @id @default(autoincrement())
  name      String
  shortName String?
  logoUrl   String?
  leagueId  Int
  status    ClubStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  league      League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  players     Player[]
  coaches     Coach[]
  homeMatches Match[]  @relation("HomeClub")
  awayMatches Match[]  @relation("AwayClub")
  standings   Standing[]

  @@map("clubs")
}

model Player {
  id          Int            @id @default(autoincrement())
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  position    PlayerPosition
  jerseyNumber Int?
  clubId      Int
  userId      Int?           @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  club      Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id])
  lineups   Lineup[]
  events    MatchEvent[]

  @@map("players")
}

model Coach {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  clubId    Int
  userId    Int?     @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  club Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@map("coaches")
}

model Referee {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  userId    Int?     @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User?           @relation(fields: [userId], references: [id])
  leagues RefereeLeague[]
  matches Match[]

  @@map("referees")
}

model RefereeLeague {
  id        Int @id @default(autoincrement())
  refereeId Int
  leagueId  Int

  referee Referee @relation(fields: [refereeId], references: [id], onDelete: Cascade)
  league  League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([refereeId, leagueId])
  @@map("referee_leagues")
}

model Match {
  id         Int         @id @default(autoincrement())
  seasonId   Int
  homeClubId Int
  awayClubId Int
  refereeId  Int?
  matchDate  DateTime
  venue      String?
  status     MatchStatus @default(SCHEDULED)
  homeScore  Int         @default(0)
  awayScore  Int         @default(0)
  matchday   Int?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Relations
  season   Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  homeClub Club         @relation("HomeClub", fields: [homeClubId], references: [id])
  awayClub Club         @relation("AwayClub", fields: [awayClubId], references: [id])
  referee  Referee?     @relation(fields: [refereeId], references: [id])
  events   MatchEvent[]
  lineups  Lineup[]

  @@map("matches")
}

model MatchEvent {
  id        Int       @id @default(autoincrement())
  matchId   Int
  playerId  Int
  type      EventType
  minute    Int
  detail    String?
  createdAt DateTime  @default(now())

  // Relations
  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id])

  @@map("match_events")
}

model Lineup {
  id        Int     @id @default(autoincrement())
  matchId   Int
  playerId  Int
  isStarter Boolean @default(true)

  // Relations
  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
  @@map("lineups")
}

model Standing {
  id             Int @id @default(autoincrement())
  seasonId       Int
  clubId         Int
  played         Int @default(0)
  won            Int @default(0)
  drawn          Int @default(0)
  lost           Int @default(0)
  goalsFor       Int @default(0)
  goalsAgainst   Int @default(0)
  goalDifference Int @default(0)
  points         Int @default(0)

  // Relations
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([seasonId, clubId])
  @@map("standings")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
