// *******************
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

///////////////////////////////////////////////////////////////
// ENUM TABLES (remain Int)
///////////////////////////////////////////////////////////////

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  userRoleScopes UserRoleScope[]

  @@map("roles")
}

model LeagueType {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  seasons Season[]

  @@map("league_types")
}

model EventType {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  matchEvents MatchEvent[]

  @@map("event_types")
}

model Position {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  description String?

  players           Player[]           @relation("PrimaryPosition")
  seasonClubPlayers SeasonClubPlayer[]
  matchLineups      MatchLineup[]

  @@map("positions")
}

///////////////////////////////////////////////////////////////
// BASIC TABLES
///////////////////////////////////////////////////////////////

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName     String
  email        String   @unique
  passwordHash String
  phone        String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userRoleScopes UserRoleScope[]
  notifications  Notification[]
  auditLogs      AuditLog[]

  @@map("users")
}

model Organization {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  country     String?
  city        String?
  foundedYear Int?
  logoUrl     String?
  description String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seasons        Season[]
  userRoleScopes UserRoleScope[]

  @@map("organizations")
}

model Club {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  shortName        String?
  country          String?
  city             String?
  foundedYear      Int?
  logoUrl          String?
  primaryStadiumId String?  @db.Uuid
  website          String?
  description      String?
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  primaryStadium Stadium?  @relation("PrimaryStadium", fields: [primaryStadiumId], references: [id])
  ownedStadiums  Stadium[] @relation("StadiumOwner")

  seasonClubs SeasonClub[]

  homeMatches Match[] @relation("HomeClub")
  awayMatches Match[] @relation("AwayClub")

  matchEvents MatchEvent[]

  userRoleScopes UserRoleScope[]

  @@map("clubs")
}

model Stadium {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  city        String?
  country     String?
  capacity    Int?
  surfaceType String?
  builtYear   Int?
  ownerClubId String?  @db.Uuid
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerClub       Club?  @relation("StadiumOwner", fields: [ownerClubId], references: [id])
  primaryForClubs Club[] @relation("PrimaryStadium")

  matches Match[]

  @@map("stadiums")
}

model Player {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName         String
  lastName          String
  dateOfBirth       DateTime?
  nationality       String?
  heightCm          Int?
  weightKg          Int?
  preferredFoot     String?
  primaryPositionId Int?
  photoUrl          String?
  status            String    @default("active")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  primaryPosition Position? @relation("PrimaryPosition", fields: [primaryPositionId], references: [id])

  seasonClubPlayers  SeasonClubPlayer[]
  matchEvents        MatchEvent[]       @relation("EventPlayer")
  relatedMatchEvents MatchEvent[]       @relation("RelatedPlayer")

  @@map("players")
}

model Coach {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  nationality     String?
  licenseLevel    String?
  experienceYears Int?
  photoUrl        String?
  status          String    @default("active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  seasonClubCoaches SeasonClubCoach[]

  @@map("coaches")
}

model Referee {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName       String
  lastName        String
  dateOfBirth     DateTime?
  nationality     String?
  licenseLevel    String?
  experienceYears Int?
  photoUrl        String?
  status          String    @default("active")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refereeLeagues RefereeLeague[]
  matchReferees  MatchReferee[]

  @@map("referees")
}

///////////////////////////////////////////////////////////////
// SEASON / MATCH
///////////////////////////////////////////////////////////////

model Season {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  leagueName     String
  leagueTypeId   Int?
  genderCategory String?
  ageCategory    String?
  divisionLevel  Int?
  startDate      DateTime
  endDate        DateTime
  pointsWin      Int      @default(3)
  pointsDraw     Int      @default(1)
  pointsLoss     Int      @default(0)
  status         String   @default("upcoming")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leagueType   LeagueType?  @relation(fields: [leagueTypeId], references: [id])

  seasonClubs SeasonClub[]
  matches     Match[]

  refereeLeagues RefereeLeague[]
  userRoleScopes UserRoleScope[]

  @@map("seasons")
}

model Match {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId    String   @db.Uuid
  homeClubId  String   @db.Uuid
  awayClubId  String   @db.Uuid
  stadiumId   String?  @db.Uuid
  matchDate   DateTime
  roundNumber Int?
  status      String   @default("scheduled")
  homeScore   Int      @default(0)
  awayScore   Int      @default(0)
  attendance  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  season   Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  homeClub Club     @relation("HomeClub", fields: [homeClubId], references: [id])
  awayClub Club     @relation("AwayClub", fields: [awayClubId], references: [id])
  stadium  Stadium? @relation(fields: [stadiumId], references: [id])

  matchEvents   MatchEvent[]
  matchReferees MatchReferee[]
  matchLineups  MatchLineup[]

  @@map("matches")
}

///////////////////////////////////////////////////////////////
// MATCH SYSTEM
///////////////////////////////////////////////////////////////

model RefereeLeague {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  refereeId    String    @db.Uuid
  seasonId     String    @db.Uuid
  roleLevel    String?
  approvedDate DateTime?
  status       String    @default("active")

  referee Referee @relation(fields: [refereeId], references: [id], onDelete: Cascade)
  season  Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([refereeId, seasonId])
  @@map("referee_leagues")
}

model MatchEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId         String   @db.Uuid
  eventTypeId     Int
  playerId        String   @db.Uuid
  relatedPlayerId String?  @db.Uuid
  clubId          String?  @db.Uuid
  minute          Int
  extraTime       Int?
  description     String?
  createdAt       DateTime @default(now())

  match         Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  eventType     EventType @relation(fields: [eventTypeId], references: [id])
  player        Player    @relation("EventPlayer", fields: [playerId], references: [id])
  relatedPlayer Player?   @relation("RelatedPlayer", fields: [relatedPlayerId], references: [id])
  club          Club?     @relation(fields: [clubId], references: [id])

  @@map("match_events")
}

model MatchReferee {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId    String   @db.Uuid
  refereeId  String   @db.Uuid
  role       String
  assignedAt DateTime @default(now())

  match   Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  referee Referee @relation(fields: [refereeId], references: [id])

  @@unique([matchId, refereeId])
  @@map("match_referees")
}

///////////////////////////////////////////////////////////////
// SEASON PARTICIPATION
///////////////////////////////////////////////////////////////

model UserRoleScope {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @db.Uuid
  roleId         Int
  organizationId String?  @db.Uuid
  seasonId       String?  @db.Uuid
  clubId         String?  @db.Uuid
  assignedAt     DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  season       Season?       @relation(fields: [seasonId], references: [id])
  club         Club?         @relation(fields: [clubId], references: [id])

  @@map("user_role_scopes")
}

model SeasonClub {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonId         String   @db.Uuid
  clubId           String   @db.Uuid
  registrationDate DateTime @default(now())
  status           String   @default("active")
  createdAt        DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  players SeasonClubPlayer[]
  coaches SeasonClubCoach[]

  @@unique([seasonId, clubId])
  @@map("season_clubs")
}

model SeasonClubPlayer {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonClubId  String    @db.Uuid
  playerId      String    @db.Uuid
  jerseyNumber  Int?
  positionId    Int?
  contractStart DateTime?
  contractEnd   DateTime?
  status        String    @default("active")
  createdAt     DateTime  @default(now())

  seasonClub SeasonClub @relation(fields: [seasonClubId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id])
  position   Position?  @relation(fields: [positionId], references: [id])

  matchLineups MatchLineup[]

  @@unique([seasonClubId, playerId])
  @@map("season_club_players")
}

model SeasonClubCoach {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seasonClubId String    @db.Uuid
  coachId      String    @db.Uuid
  role         String    @default("head_coach")
  startDate    DateTime?
  endDate      DateTime?
  status       String    @default("active")
  createdAt    DateTime  @default(now())

  seasonClub SeasonClub @relation(fields: [seasonClubId], references: [id], onDelete: Cascade)
  coach      Coach      @relation(fields: [coachId], references: [id])

  @@unique([seasonClubId, coachId])
  @@map("season_club_coaches")
}

model MatchLineup {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId            String   @db.Uuid
  seasonClubPlayerId String   @db.Uuid
  positionId         Int?
  lineupType         String   @default("starting")
  shirtNumber        Int?
  isCaptain          Boolean  @default(false)
  createdAt          DateTime @default(now())

  match            Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  seasonClubPlayer SeasonClubPlayer @relation(fields: [seasonClubPlayerId], references: [id])
  position         Position?        @relation(fields: [positionId], references: [id])

  @@unique([matchId, seasonClubPlayerId])
  @@map("match_lineups")
}

///////////////////////////////////////////////////////////////
// SYSTEM TABLES
///////////////////////////////////////////////////////////////

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  actionType String
  timestamp  DateTime @default(now())
  details    String

  user User @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
